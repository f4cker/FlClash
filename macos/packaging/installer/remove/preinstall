#!/bin/bash
set -euo pipefail
[[ "$EUID" == 0 && "${3:-/}" == / ]] || exit 78
bundle='/Library/Application Support/Flash/Flash.app'
tool="$bundle/Contents/Library/HelperTools/FlashMaintenance"
plist='/Library/LaunchDaemons/com.layoute.flash.helper.plist'
guard="$(/usr/bin/dirname "$0")/FlashMaintenance"
status=0
"$guard" beginRemove || status=$?
[[ "$status" != 10 ]] || exit 0
[[ "$status" == 0 || "$status" == 20 ]] || exit 78
if [[ "$status" == 0 ]]; then
  "$guard" arm
  if "$guard" serviceAbsent; then
    /bin/launchctl enable system/com.layoute.flash.helper
    /bin/launchctl bootstrap system "$plist"
  fi
  "$tool" prepare
  /bin/launchctl bootout system "$plist"
  "$guard" quiescent
fi
/bin/launchctl disable system/com.layoute.flash.helper
"$guard" finishRemove
