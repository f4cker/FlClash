# Clash.Meta upstream baseline: https://github.com/chen08209/Clash.Meta, branch FlClash.
# Keep the Flash fork URL/branch below: its pinned commit retains our additional patches.
[submodule "core/Clash.Meta"]
	path = core/Clash.Meta
	url = git@github.com:f4cker/Clash.Meta.git
	branch = flash/0.9.5
[submodule "plugins/prism_ui"]
	path = plugins/prism_ui
	url = git@github.com:f4cker/prism_ui.git
	branch = flash/0.9.5
